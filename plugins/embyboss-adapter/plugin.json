{
  "schemaVersion": 2,
  "id": "io.emby-manager.adapter.embyboss",
  "name": "EmbyBoss 外部账号适配器",
  "version": "2.3.1",
  "apiVersion": "2",
  "description": "将 Sakura EmbyBoss 的 Emby 账号管理协议安全映射到 EM 托管的 EA 账号生命周期。",
  "author": "Emby Manager",
  "repository": "https://github.com/emby-manager/plugins",
  "license": "MIT",
  "engines": { "embyManager": ">=0.1.9.5-rc2 <0.2.0", "node": ">=24" },
  "entrypoints": { "server": "src/server.ts" },
  "capabilities": [
    "storage.kv.read",
    "storage.kv.write",
    "external-account.provider.read",
    "external-account.provider.health.read",
    "external-account.account.read",
    "external-account.account.create",
    "external-account.account.authenticate",
    "external-account.account.password.write",
    "external-account.account.policy.write",
    "external-account.account.delete",
    "external-account.library.read",
    "external-account.items.read",
    "external-account.favorites.write",
    "external-account.provider.manage.read",
    "external-account.provider.manage.create",
    "external-account.provider.manage.update",
    "external-account.provider.manage.secret.rotate",
    "external-account.provider.manage.delete",
    "external-account.provider.manage.reconcile",
    "external-account.account.manage.read",
    "external-account.account.manage.reconcile",
    "external-account.account.manage.delete",
    "external-account.audit.read"
  ],
  "actions": [
    { "name": "load-admin", "title": "读取 EmbyBoss 接入", "access": "admin", "timeoutMs": 30000 },
    { "name": "load-accounts", "title": "读取 EmbyBoss 账号", "access": "admin", "timeoutMs": 30000 },
    { "name": "load-audits", "title": "读取 EmbyBoss 审计", "access": "admin", "timeoutMs": 30000 },
    { "name": "create-provider", "title": "创建 EmbyBoss 接入", "access": "admin", "timeoutMs": 30000 },
    { "name": "manage-provider", "title": "管理 EmbyBoss 接入", "access": "admin", "timeoutMs": 30000 },
    { "name": "manage-account", "title": "管理 EmbyBoss 账号", "access": "admin", "timeoutMs": 30000 }
  ],
  "pages": [
    {
      "id": "embyboss-admin",
      "path": "/admin/plugins/embyboss",
      "title": "EmbyBoss 账号接入",
      "description": "配置 EmbyBoss 接入、EA 映射、线路套餐与审计。",
      "icon": "Cable",
      "location": "admin",
      "schema": "ui/admin.json"
    }
  ],
  "externalAccountAdapters": [
    {
      "id": "embyboss",
      "name": "EmbyBoss",
      "description": "适配 Sakura EmbyBoss 使用的标准 Emby 账号管理请求。",
      "kind": "EMBYBOSS",
      "basePath": "/emby",
      "addressHint": "填入 EmbyBoss 的 emby_url，不要手动追加 /emby。",
      "configHint": "将接入基地址填入 emby_url，将密钥填入 emby_api；EmbyBoss 会自行追加 /emby。",
      "routes": [
        { "method": "GET", "path": "/System/Info", "handler": "system-info" },
        { "method": "GET", "path": "/System/Info/Public", "handler": "system-info" },
        { "method": "GET", "path": "/Sessions", "handler": "list-sessions" },
        { "method": "GET", "path": "/Library/VirtualFolders", "handler": "list-libraries" },
        { "method": "POST", "path": "/Users/AuthenticateByName", "handler": "authenticate-user" },
        { "method": "GET", "path": "/Users", "handler": "list-users" },
        { "method": "GET", "path": "/Users/Public", "handler": "list-users" },
        { "method": "GET", "path": "/Users/Query", "handler": "query-users" },
        { "method": "POST", "path": "/Users/New", "handler": "create-user", "timeoutMs": 60000 },
        { "method": "GET", "path": "/Users/:accountId", "handler": "get-user" },
        { "method": "POST", "path": "/Users/:accountId/Password", "handler": "set-password" },
        { "method": "POST", "path": "/Users/:accountId/Policy", "handler": "set-policy" },
        { "method": "DELETE", "path": "/Users/:accountId", "handler": "delete-user", "timeoutMs": 60000 },
        { "method": "GET", "path": "/Users/:accountId/Items", "handler": "list-items" },
        { "method": "GET", "path": "/Users/:accountId/Items/:itemId", "handler": "get-item" },
        { "method": "POST", "path": "/Users/:accountId/FavoriteItems/:itemId", "handler": "set-favorite" },
        { "method": "DELETE", "path": "/Users/:accountId/FavoriteItems/:itemId", "handler": "set-favorite" }
      ]
    }
  ]
}
