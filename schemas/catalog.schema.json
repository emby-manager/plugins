{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "author", "versions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "author": { "type": "string" },
          "homepage": { "type": "string" },
          "repository": { "type": "string" },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "downloadUrl", "packageDigest", "keyId", "engines"],
              "properties": {
                "version": { "type": "string" },
                "downloadUrl": { "type": "string" },
                "packageDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "keyId": { "type": "string" },
                "engines": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
