{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "author", "versions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "author": { "type": "string" },
          "homepage": { "type": "string" },
          "repository": { "type": "string" },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "downloadUrl", "packageDigest", "keyId", "engines"],
              "properties": {
                "version": { "type": "string" },
                "downloadUrl": { "type": "string" },
                "packageDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "keyId": { "type": "string" },
                "engines": { "type": "object" },
                "workflowTemplates": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id", "version", "title", "description", "stepCount", "readOnlySteps",
                      "supervisedWriteSteps", "requiredCapabilities", "containsIrreversibleWrite",
                      "largestStepAffectedResources", "largestStepEstimatedCostMinor"
                    ],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                      "version": { "type": "string", "pattern": "^\\d+\\.\\d+$", "maxLength": 16 },
                      "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                      "description": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "stepCount": { "type": "integer", "minimum": 1, "maximum": 50 },
                      "readOnlySteps": { "type": "integer", "minimum": 0, "maximum": 50 },
                      "supervisedWriteSteps": { "type": "integer", "minimum": 0, "maximum": 50 },
                      "requiredCapabilities": {
                        "type": "array", "maxItems": 128, "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                      },
                      "highestResourceImportance": { "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"] },
                      "containsIrreversibleWrite": { "type": "boolean" },
                      "largestStepAffectedResources": { "type": "integer", "minimum": 0, "maximum": 10000 },
                      "largestStepEstimatedCostMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
