{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.emby-manager.dev/schema/plugin-v2.json",
  "title": "Emby Manager Plugin Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "description", "author", "engines", "entrypoints", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": "2" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "author": { "type": "string", "minLength": 1, "maxLength": 191 },
    "homepage": { "type": "string", "maxLength": 2048 },
    "repository": { "type": "string", "maxLength": 2048 },
    "license": { "type": "string", "maxLength": 128 },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embyManager"],
      "properties": {
        "embyManager": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node": { "type": "string", "maxLength": 128 }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.mjs$", "maxLength": 255 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage.kv.read", "storage.kv.write", "storage.secret.read", "storage.secret.write",
          "user.profile.self.read", "user.profile.any.read",
          "user.email.self.read", "user.email.any.read", "user.directory.read",
          "points.balance.self.read", "points.balance.any.read",
          "points.balance.self.spend", "points.balance.any.adjust",
          "emby.account.self.read", "emby.account.any.read", "emby.account.expiry.write",
          "emby.connection.self.read",
          "emby.library.read",
          "session.site.self.read", "session.site.any.read",
          "session.site.self.revoke", "session.site.any.revoke",
          "device.ea.self.read", "device.ea.any.read",
          "device.ea.self.revoke", "device.ea.any.revoke",
          "playback.session.self.read", "playback.session.any.read",
          "playback.session.self.stop", "playback.session.any.stop",
          "notification.self.send", "notification.any.send", "notification.broadcast.send",
          "network.read", "network.write", "network.secret.use", "scheduler.read", "scheduler.write",
          "external-account.provider.read", "external-account.provider.health.read",
          "external-account.account.read",
          "external-account.account.create", "external-account.account.authenticate",
          "external-account.account.password.write", "external-account.account.policy.write",
          "external-account.account.delete", "external-account.library.read",
          "external-account.items.read", "external-account.favorites.write",
          "external-account.provider.manage.read", "external-account.provider.manage.create",
          "external-account.provider.manage.update", "external-account.provider.manage.secret.rotate",
          "external-account.provider.manage.delete", "external-account.provider.manage.reconcile",
          "external-account.account.manage.read", "external-account.account.manage.reconcile",
          "external-account.account.manage.delete", "external-account.audit.read"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryMb": { "type": "integer", "minimum": 32, "maximum": 512 },
        "maxConcurrentInvocations": { "type": "integer", "minimum": 1, "maximum": 16 },
        "storageMb": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedHosts"],
      "properties": {
        "allowedHosts": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "maxLength": 253 } }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "access"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "access": { "enum": ["user", "admin"] },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
        }
      }
    },
    "events": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" } },
    "eventSubscriptions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "handler", "dataFields"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
          "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$", "maxLength": 16 },
          "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "dataFields": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+){0,7}$", "maxLength": 191 } },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
        }
      }
    },
    "agentTools": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "description", "handler", "access", "executionMode", "systemOfRecord", "requiredCapabilities", "inputSchema", "outputSchema"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "access": { "enum": ["user", "admin", "service"] },
          "executionMode": { "enum": ["READ_ONLY", "SUPERVISED_WRITE"] },
          "systemOfRecord": { "enum": ["EM", "EA", "MEDIA_CATALOG", "EXTERNAL_PROVIDER", "PLUGIN", "OBSERVABILITY"] },
          "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
          "maximumResultCount": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      }
    },
    "providers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "operations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "kind": { "enum": ["METADATA", "SUBTITLE", "DOWNLOAD", "REQUEST", "ROUTE", "PAYMENT", "NOTIFICATION", "QUALITY"] },
          "protocol": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
              "version": { "type": "string", "pattern": "^\\d+\\.\\d+$", "maxLength": 16 }
            }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "handler", "requiredCapabilities", "inputSchema", "outputSchema"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "executionMode": { "enum": ["READ_ONLY", "SUPERVISED_WRITE"] },
                "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
                "inputSchema": { "type": "object" },
                "outputSchema": { "type": "object" },
                "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
              }
            }
          }
        }
      }
    },
    "workflowActivities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "handler", "requiredCapabilities", "inputSchema", "outputSchema"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "executionMode": { "enum": ["READ_ONLY", "SUPERVISED_WRITE"] },
          "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resourceImportance", "reversible", "maximumAffectedResources", "estimatedCostMinor"],
            "properties": {
              "resourceImportance": { "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"] },
              "reversible": { "type": "boolean" },
              "maximumAffectedResources": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "estimatedCostMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          }
        }
      }
    },
    "workflowTemplates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "title", "description", "inputSchema", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+$", "maxLength": 16 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "inputSchema": { "type": "object" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "activity"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "activity": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "inputFrom": { "type": "string", "pattern": "^(?:workflow|[a-z][a-z0-9_.-]{0,63})$" }
              }
            }
          }
        }
      }
    },
    "secretScopes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "allowedHosts", "placement"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "required": { "type": "boolean" },
          "allowedHosts": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$", "maxLength": 253 } },
          "allowedMethods": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] } },
          "allowedPathPrefixes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~!$&()*+,;=:@%/-]*)$", "maxLength": 512 } },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name"],
            "properties": {
              "type": { "const": "header" },
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
              "prefix": { "type": "string", "pattern": "^[\\x20-\\x7E]*$", "maxLength": 32 }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "location": { "const": "admin" } }, "required": ["location"] },
            "then": { "properties": { "path": { "type": "string", "pattern": "^/admin/plugins/[a-z0-9][a-z0-9/_-]*$" } } }
          },
          {
            "if": { "properties": { "location": { "const": "user" } }, "required": ["location"] },
            "then": { "properties": { "path": { "type": "string", "pattern": "^/plugins/[a-z0-9][a-z0-9/_-]*$" } } }
          }
        ],
        "required": ["id", "path", "title", "location", "schema"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "pattern": "^/[a-z0-9/_-]*$", "maxLength": 180 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
          "location": { "enum": ["user", "admin"] },
          "schema": { "type": "string", "pattern": "^ui/[A-Za-z0-9_./-]+\\.json$", "maxLength": 255 }
        }
      }
    },
    "externalAccountAdapters": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "basePath", "routes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "kind": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,23}$",
            "description": "Plugin-owned opaque adapter type. EM validates syntax only and has no provider-brand allowlist."
          },
          "basePath": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?$", "maxLength": 180 },
          "addressHint": { "type": "string", "maxLength": 500 },
          "configHint": { "type": "string", "maxLength": 500 },
          "routes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path", "handler"],
              "properties": {
                "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+|:[a-z][A-Za-z0-9]*)(?:/(?:[A-Za-z0-9._-]+|:[a-z][A-Za-z0-9]*))*$", "maxLength": 220 },
                "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
              }
            }
          }
        }
      }
    },
    "configSchema": { "type": "object" },
    "defaultConfig": { "type": "object" }
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 58,
      "items": { "type": "string" }
    }
  }
}
