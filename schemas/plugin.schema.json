{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.emby-manager.dev/schema/plugin-v2.json",
  "title": "Emby Manager Plugin Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "description", "author", "engines", "entrypoints", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": "2" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "author": { "type": "string", "minLength": 1, "maxLength": 191 },
    "homepage": { "type": "string", "maxLength": 2048 },
    "repository": { "type": "string", "maxLength": 2048 },
    "license": { "type": "string", "maxLength": 128 },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embyManager"],
      "properties": {
        "embyManager": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node": { "type": "string", "maxLength": 128 }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.mjs$", "maxLength": 255 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage.kv.read", "storage.kv.write", "storage.secret.read", "storage.secret.write",
          "user.profile.self.read", "user.profile.any.read",
          "user.email.self.read", "user.email.any.read", "user.directory.read",
          "emby.account.self.read", "emby.account.any.read", "emby.account.expiry.write",
          "emby.connection.self.read",
          "emby.library.read", "notification.self.send", "notification.any.send",
          "network.read", "network.write", "scheduler.read", "scheduler.write",
          "external-account.provider.read", "external-account.account.read",
          "external-account.account.create", "external-account.account.authenticate",
          "external-account.account.password.write", "external-account.account.policy.write",
          "external-account.account.delete", "external-account.library.read",
          "external-account.items.read", "external-account.favorites.write"
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedHosts"],
      "properties": {
        "allowedHosts": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "maxLength": 253 } }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "access"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "access": { "enum": ["user", "admin"] },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
        }
      }
    },
    "events": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" } },
    "pages": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "location": { "const": "admin" } }, "required": ["location"] },
            "then": { "properties": { "path": { "type": "string", "pattern": "^/admin/plugins/[a-z0-9][a-z0-9/_-]*$" } } }
          },
          {
            "if": { "properties": { "location": { "const": "user" } }, "required": ["location"] },
            "then": { "properties": { "path": { "type": "string", "pattern": "^/plugins/[a-z0-9][a-z0-9/_-]*$" } } }
          }
        ],
        "required": ["id", "path", "title", "location", "schema"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "pattern": "^/[a-z0-9/_-]*$", "maxLength": 180 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
          "location": { "enum": ["user", "admin"] },
          "schema": { "type": "string", "pattern": "^ui/[A-Za-z0-9_./-]+\\.json$", "maxLength": 255 }
        }
      }
    },
    "externalAccountAdapters": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "basePath", "routes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,23}$" },
          "basePath": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?$", "maxLength": 180 },
          "addressHint": { "type": "string", "maxLength": 500 },
          "configHint": { "type": "string", "maxLength": 500 },
          "routes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path", "handler"],
              "properties": {
                "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+|:[a-z][A-Za-z0-9]*)(?:/(?:[A-Za-z0-9._-]+|:[a-z][A-Za-z0-9]*))*$", "maxLength": 220 },
                "handler": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
                "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
              }
            }
          }
        }
      }
    },
    "configSchema": { "type": "object" },
    "defaultConfig": { "type": "object" }
  }
}
